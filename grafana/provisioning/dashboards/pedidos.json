{
  "uid": "pedidos",
  "title": "Pedidos",
  "description": "Saúde da API e acompanhamento da cobrança dos pedidos.",
  "tags": [
    "desafio",
    "observabilidade"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Erros HTTP 5xx",
      "description": "Responde se o sistema está com erro. Usa a proporção PromQL de respostas 5xx, incluindo sem_rota para capturar falhas de parsing e excluindo /health e /metrics para medir o tráfego da aplicação.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_request_duration_seconds_count{job=\"api\",route!~\"/health|/metrics\",status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(http_request_duration_seconds_count{job=\"api\",route!~\"/health|/metrics\"}[$__rate_interval]))) / (sum(rate(http_request_duration_seconds_count{job=\"api\",route!~\"/health|/metrics\"}[$__rate_interval])) > 0)",
          "legendFormat": "HTTP 5xx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Falhas técnicas de cobrança",
      "description": "Responde se o sistema está com erro mesmo quando a API retorna sucesso. Usa a proporção PromQL de cobranças com resultado falha, com os mesmos resultados de negócio usados pelo SLI.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cobrancas_processadas_total{job=\"worker\",resultado=\"falha\"}[$__rate_interval])) / (sum(rate(cobrancas_processadas_total{job=\"worker\"}[$__rate_interval])) > 0)",
          "legendFormat": "Falhas técnicas",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência p95 da API",
      "description": "Responde se o sistema está lento. Usa histogram_quantile sobre rate dos buckets agregados por le para estimar o p95 nas rotas de negócio, agrupadas por template para limitar a cardinalidade.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\",route=~\"/(produtos|pedidos)(/:id)?\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pedidos confirmados e cobranças aprovadas",
      "description": "Responde se o dinheiro está entrando. Compara taxas por segundo de pedidos confirmados e cobranças aprovadas. A diferença expõe confirmações após falha financeira e orienta a busca por pedido nos logs e traces.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pedidos_confirmados_total{job=\"worker\"}[$__rate_interval]))",
          "legendFormat": "Pedidos confirmados",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(cobrancas_processadas_total{job=\"worker\",resultado=\"aprovada\"}[$__rate_interval]))",
          "legendFormat": "Cobranças aprovadas",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
